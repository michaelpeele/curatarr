# ── Curatarr ─────────────────────────────────────────────────────────────
# Copy this file to `.env` in the same folder and adjust the values.
#   cp .env.example .env
# docker compose reads `.env` automatically — no further wiring needed.
#
# None of these are secrets (except possibly TMDB_KEY). They only tune
# how the containers are mounted and what URLs the app advertises.

# TMDB API key (optional, 32 chars).
# Blank = scanning falls back to folder-name parsing only, no posters.
# Get one at https://www.themoviedb.org/settings/api
TMDB_KEY=

# Tailscale Auth Key (optional, e.g. tskey-auth-kXXXXX-XXXXXXXXX).
# Generate from: Tailscale Admin Console > Settings > Keys
# If provided, Curatarr joins your Tailnet automatically with hostname 'curatarr'.
# You can then open http://curatarr in any Tailscale-connected browser.
TS_AUTHKEY=
# Optional extra args (e.g. TS_EXTRA_ARGS=--advertise-tags=tag:container)
TS_EXTRA_ARGS=

# SMTP email for invites & password resets (optional).
# Leave SMTP_HOST blank for dev mode: links are logged to
# `docker logs curatarr-api` instead of being sent.
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587,
# SMTP_USER/SMTP_FROM=your Gmail address, SMTP_PASSWORD=16-char App Password
# (Google Account > Security > 2-Step Verification > App passwords)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Public base URL of the web UI, used to build invite & password-reset
# links in the (console-logged) emails. Must be reachable from the
# browser of whoever uses it.
# Default matches the port the original Curatarr frontend used (5173).
# Examples:
#   same machine:        http://localhost:5173
#   LAN box:             http://192.168.1.50:5173
FRONTEND_BASE_URL=http://localhost:5173

# Host folder containing your source media (movie/show/anime roots).
# Mounted READ-ONLY at /media inside the API container.
#   - Register SourceRoots in the UI using container paths:  /media/Movies
#   - Add a PathMapping translating  /media  →  what Plex sees (e.g. /mnt/media)
#     so symlink targets point somewhere meaningful to Plex.
MEDIA_ROOT=./media

# Host folder where virtual-library symlink trees are created.
# Mounted at /output inside the API container.
#   - VirtualLibrary OutputPath in the UI should point under /output
#     (e.g. /output/VirtualLibraries) so links land on this mount.
OUTPUT_ROOT=./output

# Host ports.
# WEB_PORT = the port you open in the browser — defaults to 5173, the same
# port the original Curatarr frontend ran on (Vite dev server).
# API_PORT = direct API access for debugging / viewing console-linked emails.
WEB_PORT=5173
API_PORT=5000

# ── doctor agent (OPTIONAL) ──────────────────────────────────────────────
# Only used if you start the stack with the "doctor" profile:
#   docker compose --profile doctor up -d
# The doctor service gives an AI/automation agent Docker + codebase access
# so it can build/run/inspect/edit the Curatarr stack itself.
#
# CODEBASE_ROOT = host path to the parent of the Curatarr folder.
#   The service mounts this at /codebase:rw. Defaults to '.' (this folder).
#   e.g. CODEBASE_ROOT=/home/you/ai-projects
#   so the project lands at /codebase/Curatarr.
CODEBASE_ROOT=./
#
# DOCKER_GID = group id of the docker socket on the host (usually 999 on
#   Linux, or 0/root on macOS). Optional — the agent may need it for
#   non-root socket access. Find it with:  stat -c '%g' /var/run/docker.sock
DOCKER_GID=0