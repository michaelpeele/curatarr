# ── Curatarr ─────────────────────────────────────────────────────────────
# Copy this file to `.env` in the same folder and adjust the values.
#   cp .env.example .env
# docker compose reads `.env` automatically — no further wiring needed.
#
# These values tune container names, mounted host folders, ports, metadata,
# email, and Tailscale. `TMDB_KEY`, `SMTP_PASSWORD`, and `TS_AUTHKEY` are the
# sensitive ones; do not commit your filled-in `.env`.

# ── Stack identity ───────────────────────────────────────────────────────
# APP_NAME controls container names and the data volume (${APP_NAME}-data).
# APP_NAME_PASCAL selects the Dockerfile folder (${APP_NAME_PASCAL}.Api/Web).
# Leave these as `curatarr` / `Curatarr` unless you are running a separate stack.
APP_NAME=curatarr
APP_NAME_PASCAL=Curatarr

# Image tag used by docker-compose.yml for both app images. The build blocks
# still build from this source tree; this only names the resulting local images.
CURATARR_VERSION=latest

# TMDB API key (optional, 32 chars).
# Blank = metadata comes from cached/folder data only; no live TMDB enrichment.
# Get one at https://www.themoviedb.org/settings/api
TMDB_KEY=

# Tailscale Auth Key (optional, e.g. tskey-auth-kXXXXX-XXXXXXXXX).
# Generate from: Tailscale Admin Console > Settings > Keys
# If provided, Curatarr joins your Tailnet automatically with hostname 'curatarr'.
# You can then open http://curatarr in any Tailscale-connected browser.
TS_AUTHKEY=
# Optional extra args (e.g. TS_EXTRA_ARGS=--advertise-tags=tag:container)
TS_EXTRA_ARGS=

# SMTP email for invites & password resets (optional).
# Leave SMTP_HOST blank for dev mode: links are logged to
# `docker logs ${APP_NAME}-api` instead of being sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Public base URL of the web UI, used to build invite & password-reset links.
# Must be reachable from the browser of whoever receives the link.
# Examples:
#   same machine:  http://localhost:5173
#   LAN box:       http://192.168.1.50:5173
#   Tailnet:       https://curatarr.tail0307d.ts.net
FRONTEND_BASE_URL=http://localhost:5173

# ── Host folders ─────────────────────────────────────────────────────────
# HOST_MEDIA_DIR is mounted read-only at /media inside the API container.
#   - Register SourceRoots in the UI using container paths: /media/Movies
#   - Add a PathMapping translating /media → what Plex sees (e.g. /mnt/media)
#     so symlink targets point somewhere meaningful to Plex.
HOST_MEDIA_DIR=./media

# HOST_OUTPUT_DIR is mounted read-write at /output inside the API container.
# HOST_VIRTUAL_LIBS_DIR is mounted read-write at /output inside the web
# container so nginx can serve files created by Sync.
#   - VirtualLibrary OutputPath in the UI should point under /output
#     (e.g. /output/VirtualLibraries) so links land on this mount.
HOST_OUTPUT_DIR=./output
HOST_VIRTUAL_LIBS_DIR=./output/VirtualLibraries

# ── Host ports ───────────────────────────────────────────────────────────
# WEB_LOCAL_PORT is the host port mapped to the Tailscale/web container's :80.
# API_LOCAL_PORT is direct API access on the host for debugging and viewing
# console-linked emails in dev mode.
WEB_LOCAL_PORT=5173
API_LOCAL_PORT=5000
