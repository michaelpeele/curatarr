# Host edge proxy for Curatarr D4 blue/green slots.
# Copy to configs/edge.env and adjust before cutover.

# Public HTTPS hostname terminated by Caddy.
CURATARR_DOMAIN=curatarr.example.com

# Tailnet-only standby listener. Always proxies the non-active slot.
STANDBY_DOMAIN=:5181

# Host ports published by the blue/green slot web services.
BLUE_WEB_PORT=15173
GREEN_WEB_PORT=15273

# Active slot written to state/active-slot on first flip/rollback.
ACTIVE_SLOT=blue

# Caddy admin endpoint. With network_mode: host this is on the host network.
CADDY_ADMIN=localhost:2019

# Optional ACME account email. Leave blank to omit Caddy's email directive.
SMTP_FROM=
