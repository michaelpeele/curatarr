# D4 blue production slot example.
# Copy to an untracked local env file and adjust before deployment.

# Informational names; the slot template uses SLOT_NAME for all runtime names.
APP_NAME=curatarr-blue
APP_NAME_PASCAL=Curatarr
SLOT_NAME=blue

# Published release to deploy.
CURATARR_RELEASE_TAG=1.0.0

# Host paths. Media is shared read-only; output and virtual libraries are
# slot-specific so only the active slot writes to disk. D4 modes default these
# mounts to ro and set OUTPUT_MOUNT_MODE=rw only on the active slot.
HOST_MEDIA_DIR=/srv/curatarr/media
HOST_OUTPUT_DIR=/srv/curatarr/blue/output
HOST_VIRTUAL_LIBS_DIR=/srv/curatarr/blue/VirtualLibraries

# Host-local ports. API is bound to 127.0.0.1 by the slot template.
API_LOCAL_PORT=15100
WEB_LOCAL_PORT=15173

# Public HTTPS URL presented by the edge proxy.
FRONTEND_BASE_URL=https://curatarr.example.com

# Proxy-facing slots must keep the public cookie name across cutover.
COOKIE_NAME=curatarr.auth

# Optional metadata/email settings.
TMDB_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
